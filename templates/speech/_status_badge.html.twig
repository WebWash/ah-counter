{# Status is a cell fill plus its label, never colour alone: dashed, half, solid or crossed. #}
{% set fills = {
    pending: 'dashed',
    transcribing: 'half',
    analysing: 'half',
    coaching: 'half',
    done: 'solid',
    failed: 'crossed',
} %}
<span data-speech-status class="status"><i class="c" data-fill="{{ fills[status.value] }}" aria-hidden="true"></i>{{ status.label }}</span>
