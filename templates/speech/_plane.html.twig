{# The orange plane that heads every Speech page: title, when it was recorded, status, and the
   four figures once there is a Report. #}
{% import '_figure.html.twig' as figures %}
<header class="plane">
    <h1>{{ speech.displayTitle }}</h1>
    <p class="plane__meta">
        <span>
            Recorded {{ speech.createdAt|date('j M Y, H:i') }}
            {%- if speech.durationSeconds is not null %}{% set seconds = speech.durationSeconds|round(0, 'floor') %} · {{ seconds // 60 }}:{{ '%02d'|format(seconds % 60) }}{% endif %}
        </span>
        {{ include('speech/_status_badge.html.twig', {status: speech.status}) }}
    </p>

    {% if report|default(null) %}
        {% set whole = report.durationSeconds|round(0, 'floor') %}
        <dl class="figs">
            {% for stat in [
                {name: 'per-minute', label: 'Fillers per minute', value: report.fillersPerMinuteRounded|number_format(1)},
                {name: 'total', label: 'Fillers', value: report.totalFillers},
                {name: 'duration', label: 'Length', value: (whole // 60) ~ ':' ~ '%02d'|format(whole % 60)},
                {name: 'top-type', label: 'Most frequent', value: report.topType ?? '—'},
            ] %}
                <div data-stat="{{ stat.name }}">
                    <dt>{{ stat.label }}</dt>
                    <dd data-value>{{ stat.name == 'top-type' ? stat.value : figures.figure(stat.value) }}</dd>
                </div>
            {% endfor %}
        </dl>
    {% elseif speech.durationSeconds is not null %}
        {% set whole = speech.durationSeconds|round(0, 'floor') %}
        <dl class="figs">
            <div data-stat="duration">
                <dt>Length</dt>
                <dd data-value>{{ figures.figure((whole // 60) ~ ':' ~ '%02d'|format(whole % 60)) }}</dd>
            </div>
        </dl>
    {% endif %}
</header>
