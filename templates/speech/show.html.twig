{% extends 'base.html.twig' %}

{% block title %}{{ speech.displayTitle }} · Ah Counter{% endblock %}

{% block body %}
    <main id="main" class="page">
        {% if speech.status.value != 'failed' and page %}
            {{ include('speech/_report.html.twig') }}
        {% else %}
            <div class="sheet">
                <div class="sheet__side">
                    {{ include('speech/_heading.html.twig') }}
                </div>

                <div class="sheet__main">
                    {% if speech.status.value == 'failed' %}
                        <section class="state">
                            <h2 class="state__title">We couldn't analyse this Speech</h2>
                            <p role="alert" class="notice">{{ speech.error ?? 'Something went wrong while processing it.' }}</p>
                            <div class="actions">
                                <form method="post" action="{{ path('speech_retry', {id: speech.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token(constant('App\\Controller\\SpeechController::RETRY_TOKEN_ID')) }}">
                                    <button type="submit" class="btn">Retry</button>
                                </form>
                                {{ include('speech/_delete_form.html.twig') }}
                            </div>
                        </section>
                    {% elseif speech.status.value == 'done' %}
                        {# Only a Speech finished before the pipeline saved Fillers can get here. #}
                        <section class="state">
                            <h2 class="state__title">No Report for this Speech</h2>
                            <p class="hint">It finished processing without any Fillers saved, so there is nothing to show. Delete it and record again.</p>
                            <div class="actions">{{ include('speech/_delete_form.html.twig') }}</div>
                        </section>
                    {% else %}
                        <section class="state"
                                 data-controller="speech-status"
                                 data-speech-status-url-value="{{ path('speech_status', {id: speech.id}) }}"
                                 data-speech-status-status-value="{{ speech.status.value }}">
                            <h2 class="state__title">
                                {{ speech.status.value == 'pending' ? 'Waiting to start…' : 'Analysing your Speech…' }}
                            </h2>
                            <p class="hint">This usually takes under a minute. The page updates by itself.</p>

                            <ol class="steps">
                                {% for step in steps %}
                                    {% set state = step.order < speech.status.order ? 'complete' : (step == speech.status ? 'current' : 'upcoming') %}
                                    <li data-step="{{ step.value }}" data-step-state="{{ state }}"
                                        {% if state == 'current' %}aria-current="step"{% endif %}>
                                        {{ include('_icon.html.twig', {name: {complete: 'done', current: 'working', upcoming: 'waiting'}[state]}) }}
                                        <span>{{ {transcribing: 'Transcribing', analysing: 'Finding Fillers', coaching: 'Writing Coaching'}[step.value] }}</span>
                                        <small>{{ {complete: 'Done', current: 'Now', upcoming: 'Next'}[state] }}</small>
                                    </li>
                                {% endfor %}
                            </ol>
                        </section>
                    {% endif %}
                </div>
            </div>
        {% endif %}
    </main>
{% endblock %}
