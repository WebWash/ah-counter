{# The Report of a done Speech (SPEC §7 "Report page layout"). #}
{% macro clock(seconds) %}{% set whole = seconds|round(0, 'floor') %}{{ whole // 60 }}:{{ '%02d'|format(whole % 60) }}{% endmacro %}
{% import _self as report_helpers %}

{% set report = page.report %}
{% set markers = page.countedFillers|map(c => {start: c.filler.start, end: c.filler.end, kind: c.filler.kind.value, type: c.filler.type}) %}
{# One fill per kind, shared by the seconds grid, bars, Transcript and Filler list: solid for a
   Filler Sound, a diagonal half for a Filler Phrase. #}
{% set fills = {sound: 'solid', phrase: 'half'} %}

{# The seconds grid: one cell per second of the Recording, more cells per row for longer Speeches. #}
{% set total = max(1, report.durationSeconds|round(0, 'ceil')) %}
{% set cols = total <= 60 ? 10 : (total <= 150 ? 20 : 30) %}
{% set by_second = {} %}
{% for item in page.countedFillers %}
    {% set key = 's' ~ min(total - 1, item.filler.start|round(0, 'floor')) %}
    {% set by_second = by_second|merge({(key): (by_second[key] ?? [])|merge([item.filler])}) %}
{% endfor %}

<div class="flex flex-1 flex-col"
     data-controller="report-player"
     data-report-player-fillers-value="{{ markers|json_encode }}">

    <div class="top">
        {# 1 and 2. Title, date and the four figures #}
        {{ include('speech/_plane.html.twig', {report: report}) }}

        {# 3. The Recording: seconds grid, Play and the waveform #}
        <section aria-label="Recording" class="work">
            <audio data-report-player-target="audio" src="{{ path('speech_recording', {id: speech.id}) }}" preload="auto"></audio>

            <div class="work__head">
                <h2 class="label">One cell is one second</h2>
                <p class="key">
                    <span><i class="c" data-fill="solid" aria-hidden="true"></i>Filler Sound</span>
                    <span><i class="c" data-fill="half" aria-hidden="true"></i>Filler Phrase</span>
                </p>
            </div>

            <div class="seconds" data-cols="{{ cols }}" style="--cols: {{ cols }}; --cell: {{ cols == 10 ? 48 : 24 }}px"
                 role="group" aria-label="The Recording, second by second. Filled cells are Fillers."
                 data-action="click->report-player#seekCell">
                <div class="seconds__lines">
                    {# Ten seconds at a time; CSS sets how many of these sit on one line. #}
                    {% for decade in 0..((total - 1) // 10) %}
                        <div class="decade">
                            <span class="seconds__t">{{ report_helpers.clock(decade * 10) }}</span>
                            <span class="seconds__cells">
                                {%- for i in 0..9 -%}
                                    {%- set second = decade * 10 + i -%}
                                    {%- set here = by_second['s' ~ second] ?? [] -%}
                                    {%- if second >= total -%}
                                        <span class="cell cell--off"></span>
                                    {%- elseif here is empty -%}
                                        <span class="cell" data-report-player-target="cell" data-second="{{ second }}"></span>
                                    {%- else -%}
                                        {%- set kinds = here|map(f => f.kind.value)|reduce((seen, kind) => kind in seen ? seen : seen|merge([kind]), []) -%}
                                        <button type="button" class="cell" data-report-player-target="cell" data-second="{{ second }}"
                                                data-start="{{ (here|first).start }}" data-kind="{{ kinds|length > 1 ? 'mixed' : kinds|first }}"
                                                aria-label="Play {{ here|map(f => f.type)|join(' and ') }} at {{ report_helpers.clock(second) }}, {{ here|map(f => f.kind.label)|join(' and ') }}"></button>
                                    {%- endif -%}
                                {%- endfor -%}
                            </span>
                        </div>
                    {% endfor %}
                </div>
            </div>

            <div class="transport">
                <button type="button"
                        data-report-player-target="playButton"
                        data-action="report-player#toggle"
                        aria-pressed="false"
                        class="btn">Play</button>
                <div data-report-player-target="waveform" class="transport__wave"></div>
                <span data-report-player-target="time" class="transport__time">0:00 / {{ report_helpers.clock(report.durationSeconds) }}</span>
            </div>
            <p data-report-player-target="waveformError" hidden class="hint mt-3">
                This browser couldn't draw the waveform, but Play and every link below still work.
            </p>
        </section>
    </div>

    <div class="sheet">
        <div class="report">
            {# 4. Filler list #}
            {% if page.countedFillers is not empty %}
                <section data-filler-list aria-labelledby="filler-list-heading">
                    <h2 id="filler-list-heading" class="label label--ruled">Every Filler</h2>
                    <table class="rows">
                        <thead>
                            <tr>
                                <th scope="col">Time</th>
                                <th scope="col">Type</th>
                                <th scope="col">Context</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in page.countedFillers %}
                                {% set filler = item.filler %}
                                <tr data-start="{{ filler.start }}" data-action="click->report-player#seek"
                                    data-report-player-target="row" data-end="{{ filler.end }}">
                                    <td>
                                        <button type="button" class="timelink"
                                                aria-label="Play from {{ report_helpers.clock(filler.start) }}">{{ report_helpers.clock(filler.start) }}</button>
                                    </td>
                                    <td><i class="c" data-fill="{{ fills[filler.kind.value] }}" role="img" aria-label="{{ filler.kind.label }}"></i>{{ filler.type }}</td>
                                    <td>
                                        {{ item.context.before }} <strong>{{ item.context.filler }}</strong> {{ item.context.after }}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </section>
            {% else %}
                <section data-no-fillers class="praise">
                    <h2>No Fillers counted</h2>
                    <p>Nothing in this Speech counted as a Filler. Well done: keep using pauses instead.</p>
                </section>
            {% endif %}

            <div class="report__side">
                {# 5. Breakdown by Filler Type #}
                {% if report.totalFillers > 0 %}
                    <section data-breakdown aria-labelledby="breakdown-heading">
                        <h2 id="breakdown-heading" class="label label--ruled">Fillers by type</h2>
                        <p class="hint mt-3">{{ report.soundCount }} Filler Sound{{ report.soundCount == 1 ? '' : 's' }} · {{ report.phraseCount }} Filler Phrase{{ report.phraseCount == 1 ? '' : 's' }}</p>
                        <ul class="types">
                            {% for type, count in report.byType %}
                                {% set kind = page.kindOf(type).value %}
                                <li data-filler-type="{{ type }}" data-kind="{{ kind }}">
                                    <span class="truncate">{{ type }}</span>
                                    <span class="types__run" aria-hidden="true">{% for n in 1..count %}<i class="c" data-fill="{{ fills[kind] }}"></i>{% endfor %}</span>
                                    <span data-count>{{ count }}</span>
                                </li>
                            {% endfor %}
                        </ul>
                    </section>
                {% endif %}

                {# 6. Coaching #}
                {% set coaching = report.coaching %}
                {% if coaching is not null %}
                    <section data-coaching aria-labelledby="coaching-heading" class="coaching">
                        <h2 id="coaching-heading" class="label label--ruled">Coaching</h2>
                        <p data-coaching-summary class="coaching__summary">{{ coaching.summary }}</p>
                        {% if coaching.patterns is not empty %}
                            <h3>What we noticed</h3>
                            <ul data-coaching-patterns>
                                {% for pattern in coaching.patterns %}<li>{{ pattern }}</li>{% endfor %}
                            </ul>
                        {% endif %}
                        {% if coaching.tips is not empty %}
                            <h3>Try next time</h3>
                            <ul data-coaching-tips>
                                {% for tip in coaching.tips %}<li>{{ tip }}</li>{% endfor %}
                            </ul>
                        {% endif %}
                    </section>
                {% endif %}

                {# Candidates the judge let stand, with its reason in plain sight (not only a tooltip). #}
                {% set let_stand = page.segments|filter(segment => segment.occurrence is not null and not segment.occurrence.isFiller) %}
                {% if let_stand is not empty %}
                    <section data-not-counted aria-labelledby="not-counted-heading">
                        <h2 id="not-counted-heading" class="label label--ruled">Checked and not counted</h2>
                        <ul class="notes">
                            {% for segment in let_stand %}
                                {% set occurrence = segment.occurrence %}
                                <li>
                                    <button type="button" class="timelink justify-self-start" data-action="report-player#seek" data-start="{{ segment.start }}"
                                            aria-label="Play from {{ report_helpers.clock(segment.start) }}">{{ report_helpers.clock(segment.start) }}</button>
                                    <span>
                                        <b>{{ segment.words|map(word => word.punctuated)|join(' ') }}</b>
                                        <span>{{ occurrence.verdict.value == 'not_filler' ? (occurrence.reason ?? 'A genuine use of the word.') : 'This Candidate has not been judged.' }}</span>
                                    </span>
                                </li>
                            {% endfor %}
                        </ul>
                    </section>
                {% endif %}
            </div>

            {# 7. Interactive transcript #}
            <section aria-labelledby="transcript-heading" class="report__main">
                <h2 id="transcript-heading" class="label label--ruled">Transcript</h2>
                <p class="hint mt-3">Press any word to hear it from there. Words with a dashed underline were checked and not counted; each reason is listed under "Checked and not counted".</p>
                <p class="key mt-2">
                    <span><i class="c" data-fill="solid" aria-hidden="true"></i>Filler Sound</span>
                    <span><i class="c" data-fill="half" aria-hidden="true"></i>Filler Phrase</span>
                    <span><i class="c" data-fill="dashed" aria-hidden="true"></i>Checked and not counted</span>
                </p>
                <div data-transcript class="transcript">
                    {%- for segment in page.segments %}
                        {% set occurrence = segment.occurrence %}
                        {% set text = segment.words|map(word => word.punctuated)|join(' ') %}
                        {% if occurrence is null %}
                            <button type="button" tabindex="-1" data-report-player-target="segment" data-action="report-player#seek" data-start="{{ segment.start }}"
                                    class="w">{{ text }}</button>
                        {% elseif occurrence.isFiller %}
                            <button type="button" data-report-player-target="segment" data-action="report-player#seek" data-start="{{ segment.start }}"
                                    data-verdict="filler" data-kind="{{ occurrence.kind.value }}"
                                    title="{{ occurrence.kind.label }}: {{ occurrence.type }}{{ occurrence.reason ? ' (' ~ occurrence.reason ~ ')' }}"
                                    class="w">{{ text }}</button>
                        {% else %}
                            <button type="button" tabindex="-1" data-report-player-target="segment" data-action="report-player#seek" data-start="{{ segment.start }}"
                                    data-verdict="{{ occurrence.verdict.value }}" data-kind="{{ occurrence.kind.value }}"
                                    title="Not counted: {{ occurrence.verdict.value == 'not_filler' ? (occurrence.reason ?? 'a genuine use of the word') : 'this Candidate has not been judged' }}"
                                    class="w">{{ text }}</button>
                        {% endif %}
                    {%- endfor %}
                </div>
            </section>

            {# The page ends on the next attempt; Delete sits beside it as the secondary action. #}
            <div class="report__wide actions">
                <a class="btn" href="{{ path('app_home') }}#recorder">New Speech</a>
                {{ include('speech/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
</div>
