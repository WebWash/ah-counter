{# The Report of a done Speech (SPEC §7 "Report page layout"), set as a tally sheet: the count in
   words and tally marks on the left, the Recording and its Transcript on the right. #}
{% macro clock(seconds) %}{% set whole = seconds|round(0, 'floor') %}{{ whole // 60 }}:{{ '%02d'|format(whole % 60) }}{% endmacro %}
{# A length in words: "54 seconds", "1 minute 2 seconds". #}
{% macro spoken(seconds) %}
    {%- set whole = seconds|round(0, 'floor') -%}
    {%- set m = whole // 60 -%}{%- set s = whole % 60 -%}
    {%- if m > 0 %}{{ m }}&nbsp;minute{{ m == 1 ? '' : 's' }}{% endif -%}
    {%- if m > 0 and s > 0 %} {% endif -%}
    {%- if s > 0 or m == 0 %}{{ s }}&nbsp;second{{ s == 1 ? '' : 's' }}{% endif -%}
{% endmacro %}
{% import _self as report_helpers %}

{% set report = page.report %}
{% set markers = page.countedFillers|map(c => {start: c.filler.start, end: c.filler.end, kind: c.filler.kind.value, type: c.filler.type}) %}

<div class="sheet"
     data-controller="report-player"
     data-report-player-fillers-value="{{ markers|json_encode }}">

    <div class="sheet__side">
        {{ include('speech/_heading.html.twig', {report: report}) }}

        <p class="summary">
            <span data-stat="total"><span data-value>{{ report.totalFillers }}</span> Filler{{ report.totalFillers == 1 ? '' : 's' }}</span>
            in {{ report_helpers.spoken(report.durationSeconds) }}
        </p>
        <p class="facts">
            <span data-stat="per-minute"><b data-value>{{ report.fillersPerMinuteRounded|number_format(1) }}</b> Fillers per minute.</span>
            <span data-stat="top-type">Most often: <b data-value>{{ report.topType ?? '—' }}</b>.</span>
        </p>

        {% if report.totalFillers > 0 %}
            <div class="summary__tally">{{ include('_tally.html.twig', {count: report.totalFillers, cap: 50}) }}</div>

            <section data-breakdown aria-labelledby="breakdown-heading">
                <h2 id="breakdown-heading" class="heading">By word</h2>
                <ul class="tallies">
                    {% for type, count in report.byType %}
                        {% set kind = page.kindOf(type) %}
                        <li data-filler-type="{{ type }}" data-kind="{{ kind.value }}">
                            <span class="tallies__word">{{ type }}<small>{{ kind.value == 'sound' ? 'Sound' : 'Phrase' }}</small></span>
                            {{ include('_tally.html.twig', {count: count}) }}
                            <span class="tallies__count" data-count>{{ count }}</span>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% else %}
            <section data-no-fillers class="praise">
                <h2 class="heading">No Fillers counted</h2>
                <p>Nothing in this Speech counted as a Filler. Well done: keep using pauses instead.</p>
            </section>
        {% endif %}

        {% set coaching = report.coaching %}
        {% if coaching is not null %}
            <section data-coaching aria-labelledby="coaching-heading" class="coaching">
                <h2 id="coaching-heading" class="heading">Coaching</h2>
                <p data-coaching-summary class="coaching__summary">{{ coaching.summary }}</p>
                {% if coaching.patterns is not empty %}
                    <h3>What we noticed</h3>
                    <ul data-coaching-patterns>
                        {% for pattern in coaching.patterns %}<li>{{ pattern }}</li>{% endfor %}
                    </ul>
                {% endif %}
                {% if coaching.tips is not empty %}
                    <h3>Try next time</h3>
                    <ul data-coaching-tips>
                        {% for tip in coaching.tips %}<li>{{ tip }}</li>{% endfor %}
                    </ul>
                {% endif %}
            </section>
        {% endif %}
    </div>

    <div class="sheet__main">
        <section aria-labelledby="listen-heading">
            <h2 id="listen-heading" class="heading">Listen</h2>
            <audio data-report-player-target="audio" src="{{ path('speech_recording', {id: speech.id}) }}" preload="auto"></audio>
            <div class="transport">
                <button type="button"
                        data-report-player-target="playButton"
                        data-action="report-player#toggle"
                        aria-pressed="false"
                        class="btn btn--play">
                    <span data-report-player-target="playIcon" class="btn__icon">{{ include('_icon.html.twig', {name: 'play'}) }}</span>
                    <span data-report-player-target="playLabel">Play</span>
                </button>
                <div data-report-player-target="waveform" class="transport__wave"></div>
                <span data-report-player-target="time" class="transport__time">0:00 / {{ report_helpers.clock(report.durationSeconds) }}</span>
            </div>
            <p data-report-player-target="waveformError" hidden class="hint">
                This browser couldn't draw the waveform, but Play and every word below still work.
            </p>
        </section>

        <section aria-labelledby="transcript-heading">
            <h2 id="transcript-heading" class="heading">Transcript</h2>
            <div data-transcript class="transcript">
                {%- for segment in page.segments %}
                    {% set occurrence = segment.occurrence %}
                    {% set text = segment.words|map(word => word.punctuated)|join(' ') %}
                    {% if occurrence is null %}
                        <button type="button" tabindex="-1" data-report-player-target="segment" data-action="report-player#seek" data-start="{{ segment.start }}"
                                class="w">{{ text }}</button>
                    {% elseif occurrence.isFiller %}
                        <button type="button" data-report-player-target="segment" data-action="report-player#seek" data-start="{{ segment.start }}"
                                data-verdict="filler" data-kind="{{ occurrence.kind.value }}"
                                aria-label="{{ text }} ({{ occurrence.kind.label }}), play from {{ report_helpers.clock(segment.start) }}"
                                title="{{ occurrence.kind.label }}: {{ occurrence.type }}{{ occurrence.reason ? ' (' ~ occurrence.reason ~ ')' }}"
                                class="w">{{ text }}</button>
                    {% else %}
                        <button type="button" tabindex="-1" data-report-player-target="segment" data-action="report-player#seek" data-start="{{ segment.start }}"
                                data-verdict="{{ occurrence.verdict.value }}" data-kind="{{ occurrence.kind.value }}"
                                title="Not counted: {{ occurrence.verdict.value == 'not_filler' ? (occurrence.reason ?? 'a genuine use of the word') : 'not checked yet' }}"
                                class="w">{{ text }}</button>
                    {% endif %}
                {%- endfor %}
            </div>
            <p class="key">
                Press any word to hear it.
                <mark class="hl" data-kind="sound">Filled</mark> is a Filler Sound like "uh";
                <mark class="hl" data-kind="phrase">underlined</mark> is a Filler Phrase like "you know";
                <span class="key__off">dotted</span> was checked and not counted.
            </p>
        </section>

        {% if page.countedFillers is not empty %}
            <section data-filler-list>
                <details class="fold">
                <summary class="heading"><h2>Every Filler with its time</h2><span class="fold__count">{{ page.countedFillers|length }}</span></summary>
                <table class="rows">
                    <thead>
                        <tr>
                            <th scope="col">Time</th>
                            <th scope="col">Filler</th>
                            <th scope="col">Sentence</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in page.countedFillers %}
                            {% set filler = item.filler %}
                            <tr data-start="{{ filler.start }}" data-action="click->report-player#seek"
                                data-report-player-target="row" data-end="{{ filler.end }}">
                                <td>
                                    <button type="button" class="timelink"
                                            aria-label="Play {{ filler.type }} ({{ filler.kind.label }}) from {{ report_helpers.clock(filler.start) }}">{{ report_helpers.clock(filler.start) }}</button>
                                </td>
                                <td><mark class="hl" data-kind="{{ filler.kind.value }}">{{ filler.type }}</mark></td>
                                <td>{{ item.context.before }} <strong>{{ item.context.filler }}</strong> {{ item.context.after }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
                </details>
            </section>
        {% endif %}

        {# Candidates the judge let stand, with its reason in plain sight (not only a tooltip). #}
        {% set let_stand = page.segments|filter(segment => segment.occurrence is not null and not segment.occurrence.isFiller) %}
        {% if let_stand is not empty %}
            <section data-not-counted aria-labelledby="not-counted-heading">
                <h2 id="not-counted-heading" class="heading">Checked and not counted</h2>
                <ul class="notes">
                    {% for segment in let_stand %}
                        {% set occurrence = segment.occurrence %}
                        <li>
                            <button type="button" class="timelink" data-action="report-player#seek" data-start="{{ segment.start }}"
                                    aria-label="Play from {{ report_helpers.clock(segment.start) }}">{{ report_helpers.clock(segment.start) }}</button>
                            <span>
                                <b>{{ segment.words|map(word => word.punctuated)|join(' ') }}</b>
                                <span>{{ occurrence.verdict.value == 'not_filler' ? (occurrence.reason ?? 'A genuine use of the word.') : 'Not checked yet, so not counted.' }}</span>
                            </span>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}

        {# The page ends on the next attempt; Delete sits beside it as the secondary action. #}
        <div class="actions">
            <a class="btn" href="{{ path('app_home') }}#recorder">{{ include('_icon.html.twig', {name: 'mic'}) }}New Speech</a>
            {{ include('speech/_delete_form.html.twig') }}
        </div>
    </div>
</div>
