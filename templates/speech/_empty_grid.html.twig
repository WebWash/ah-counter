{# A Speech's seconds grid before there is a Report: its length is known, its Fillers are not.
   mode "sweep" steps a lit cell across it while the Speech is processed; mode "off" draws
   every cell dashed, for a Speech that was not analysed. #}
{% set total = max(1, seconds|round(0, 'ceil')) %}
{% set cols = total <= 60 ? 10 : (total <= 150 ? 20 : 30) %}
<div class="seconds" data-cols="{{ cols }}" style="--cols: {{ cols }}; --cell: {{ cols == 10 ? 48 : 24 }}px; --sweep: {{ (total * 0.1)|round(1) }}s" aria-hidden="true">
    <div class="seconds__lines">
        {% for decade in 0..((total - 1) // 10) %}
            <div class="decade">
                <span class="seconds__t">{{ (decade * 10) // 60 }}:{{ '%02d'|format((decade * 10) % 60) }}</span>
                <span class="seconds__cells">
                    {%- for i in 0..9 -%}
                        {%- set second = decade * 10 + i -%}
                        {%- if second >= total or mode == 'off' -%}
                            <span class="cell cell--still cell--off"></span>
                        {%- else -%}
                            <span class="cell cell--still cell--sweep" style="--i: {{ second }}"></span>
                        {%- endif -%}
                    {%- endfor -%}
                </span>
            </div>
        {% endfor %}
    </div>
</div>
