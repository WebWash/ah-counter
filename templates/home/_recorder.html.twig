{# The recorder (SPEC §7, ticket 07): what the page is for on the left, the recorder on the right.
   Panels are switched by assets/controllers/recorder_controller.js. #}
<section class="sheet" id="recorder"
         aria-label="Recorder"
         data-controller="recorder"
         data-recorder-upload-url-value="{{ path('speech_upload') }}"
         data-recorder-csrf-token-value="{{ csrf_token(constant('App\\Controller\\SpeechController::UPLOAD_TOKEN_ID')) }}">

    <div class="sheet__side">
        <h1 class="lead"><span class="sr-only">Ah Counter: </span>Record a short English speech and see every "um", "uh" and "you know" you said.</h1>
        <p class="lead__sub">Each Filler is counted, timed and played back, with Coaching for the next attempt.</p>
    </div>

    <div class="sheet__main recorder">
        <h2 class="heading">New Speech</h2>

        <div data-recorder-target="panel" data-panel="idle" class="recorder__row">
            <button type="button" data-action="recorder#start" class="btn btn--big">
                {{ include('_icon.html.twig', {name: 'mic'}) }}
                Record
            </button>
            <p class="hint">Speak in English for 10 seconds to 5 minutes.</p>
        </div>

        <div data-recorder-target="panel" data-panel="recording" hidden class="recorder__row">
            <button type="button" data-action="recorder#stop" class="btn btn--big btn--stop">
                {{ include('_icon.html.twig', {name: 'stop'}) }}
                Stop
            </button>
            <p class="recorder__live"><span class="recorder__dot" aria-hidden="true"></span>Recording</p>
        </div>

        {# The clock: time so far against the five-minute limit, with the last 30 seconds marked. #}
        <div data-recorder-target="panel" data-panel="idle recording" class="clock">
            <p class="clock__time" aria-live="off" data-recorder-target="timer">0:00 / 5:00</p>
            <div class="clock__meter" aria-hidden="true">
                <span class="clock__fill" data-recorder-target="progress"></span>
                <span class="clock__warn"></span>
            </div>
            <p class="clock__scale" aria-hidden="true"><span>0:00</span><span>4:30</span><span>5:00</span></p>
        </div>

        <div data-recorder-target="panel" data-panel="recording" hidden>
            <p data-recorder-target="warning" hidden role="status" class="notice">
                30 seconds left. Recording stops by itself at 5:00.
            </p>
        </div>

        <div data-recorder-target="panel" data-panel="recording review" hidden class="recorder__wavepanel">
            <div data-recorder-target="waveform" class="recorder__wave"></div>
        </div>

        <div data-recorder-target="panel" data-panel="review" hidden class="recorder__review">
            <div class="recorder__row">
                <button type="button"
                        data-recorder-target="playButton"
                        data-action="recorder#togglePlayback"
                        aria-pressed="false"
                        class="btn btn--open">Play</button>
                <p class="recorder__length">Length <b data-recorder-target="reviewDuration">0:00</b></p>
            </div>

            <div class="field-group">
                <label for="speech-title" class="label">Title <span class="label__opt">(optional)</span></label>
                <input id="speech-title" type="text" maxlength="120" autocomplete="off"
                       data-recorder-target="title"
                       data-action="keydown.enter->recorder#analyse"
                       placeholder="e.g. Icebreaker, club meeting 17 Nov"
                       class="field">
            </div>

            <div class="recorder__row">
                <button type="button" data-action="recorder#analyse" class="btn">Analyse</button>
                <button type="button" data-action="recorder#discard" class="btn btn--open">Discard</button>
            </div>
        </div>

        <div data-recorder-target="panel" data-panel="uploading" hidden role="status">
            <p class="state__title">Uploading your Speech…</p>
        </div>

        <p data-recorder-target="message" hidden role="alert" class="notice"></p>

        <noscript>
            <p class="notice">Recording needs JavaScript. Please enable it and reload the page.</p>
        </noscript>
    </div>
</section>
