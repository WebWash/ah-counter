<section aria-labelledby="recent-speeches">
    <h2 id="recent-speeches" class="label label--ruled">Your recent speeches</h2>

    {% if speeches is empty %}
        <p data-speech-list-empty class="empty">
            No speeches yet. Each Speech you record will appear here.
        </p>
    {% else %}
        <ul data-speech-list class="speeches">
            {% for speech in speeches %}
                <li>
                    <a href="{{ path('speech_show', {id: speech.id}) }}">
                        <div class="min-w-0">
                            <p data-speech-title class="speeches__title">{{ speech.displayTitle }}</p>
                            <p class="speeches__date">{{ speech.createdAt|date('j M Y, H:i') }}</p>
                        </div>
                        <p class="speeches__rate">
                            {% if speech.status.value == 'done' %}
                                {% set report = reports[speech.id.toRfc4122] ?? null %}
                                <span {% if report %}data-fillers-per-minute{% endif %}>{{ report ? report.fillersPerMinuteRounded|number_format(1) : '—' }}</span>
                                Fillers per minute
                            {% endif %}
                        </p>
                        {{ include('speech/_status_badge.html.twig', {status: speech.status}) }}
                    </a>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</section>
