<section aria-labelledby="recent-speeches">
    <h2 id="recent-speeches" class="heading">Your recent speeches</h2>

    {% if speeches is empty %}
        <p data-speech-list-empty class="empty">
            No speeches yet. Each Speech you record will appear here.
        </p>
    {% else %}
        <ul data-speech-list class="speeches">
            {% for speech in speeches %}
                <li>
                    <a href="{{ path('speech_show', {id: speech.id}) }}">
                        <span class="speeches__name">
                            <span data-speech-title class="speeches__title">{{ speech.displayTitle }}</span>
                            {% if speech.title is not null %}<span class="speeches__date">{{ speech.createdAt|date('j M Y, H:i') }}</span>{% else %}<span class="speeches__date">Untitled Speech</span>{% endif %}
                        </span>
                        <span class="speeches__rate">
                            {% if speech.status.value == 'done' %}
                                {% set report = reports[speech.id.toRfc4122] ?? null %}
                                <b {% if report %}data-fillers-per-minute{% endif %}>{{ report ? report.fillersPerMinuteRounded|number_format(1) : '—' }}</b>
                                Fillers per minute
                            {% endif %}
                        </span>
                        {{ include('speech/_status_badge.html.twig', {status: speech.status}) }}
                    </a>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</section>
